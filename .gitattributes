* text=auto eol=lf

# Arte em pixel: pequena, fica no git comum (marcada como binária)
*.png      binary
*.gif      binary
*.aseprite binary
*.ase      binary

# Paleta é texto
*.gpl      text eol=lf

# Pesados: LFS (só se um dia aparecerem)
*.psd  filter=lfs diff=lfs merge=lfs -text
*.kra  filter=lfs diff=lfs merge=lfs -text
*.mp4  filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text